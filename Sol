<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Para Solanch</title>

  <!-- QR (CDN). Si quieres 100% offline, dímelo y lo incrusto completo -->
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600&family=Nunito:wght@400;700&display=swap');

    :root {
      --bg-color: #fdfcf0;
      --heart-red: #d32f2f;
      --heart-pink: #e57373;
      --heart-light: #ffcdd2;
      --text-color: #4a4a4a;
      --accent-color: #c62828;
      --card-bg: #fffaf0;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-color);
      font-family: 'Nunito', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow-x: hidden;
    }

    .container {
      background-color: var(--card-bg);
      width: 100%;
      max-width: 420px;
      min-height: 100vh;
      padding: 20px 18px 24px;
      box-shadow: 0 0 20px rgba(0,0,0,0.06);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: left;
      position: relative;
      overflow: hidden;
      border-radius: 18px;
    }

    .header-text {
      width: 100%;
      margin-top: 10px;
      color: var(--text-color);
    }

    h1 {
      font-family: 'Dancing Script', cursive;
      color: var(--accent-color);
      font-size: 2.1rem;
      margin: 8px 0 10px;
    }

    p {
      font-size: 1.06rem;
      line-height: 1.55;
      margin: 0 0 12px;
      color: #555;
    }

    /* Árbol */
    .tree-container {
      position: relative;
      width: 300px;
      height: 350px;
      margin: 14px auto 6px;
      display: flex;
      justify-content: center;
      align-items: flex-end;
      filter: drop-shadow(0 8px 12px rgba(0,0,0,0.05));
    }

    .trunk {
      width: 22px;
      height: 112px;
      background: linear-gradient(180deg, #a1887f, #6d4c41);
      position: absolute;
      bottom: 0;
      border-radius: 7px;
      z-index: 1;
    }

    .leaves-container {
      position: absolute;
      bottom: 85px;
      width: 250px;
      height: 250px;
      z-index: 2;
    }

    .heart {
      position: absolute;
      width: 15px;
      height: 15px;
      background-color: var(--heart-red);
      transform: rotate(45deg);
      animation: pulse 2.2s infinite ease-in-out;
      border-radius: 2px;
    }

    .heart::before, .heart::after {
      content: "";
      position: absolute;
      width: 15px;
      height: 15px;
      background-color: inherit;
      border-radius: 50%;
    }

    .heart::before { top: -8px; left: 0; }
    .heart::after { left: -8px; top: 0; }

    @keyframes pulse {
      0% { transform: scale(1) rotate(45deg); }
      50% { transform: scale(1.12) rotate(45deg); }
      100% { transform: scale(1) rotate(45deg); }
    }

    /* Barra de acciones */
    .actions {
      width: 100%;
      display: flex;
      gap: 10px;
      justify-content: center;
      align-items: center;
      margin: 8px 0 2px;
      flex-wrap: wrap;
    }

    .btn {
      border: none;
      cursor: pointer;
      padding: 12px 14px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.95rem;
      transition: transform 0.08s ease, box-shadow 0.2s ease, opacity 0.2s ease;
      display: inline-flex;
      gap: 8px;
      align-items: center;
      justify-content: center;
      user-select: none;
    }

    .btn:active { transform: scale(0.98); }
    .btn-primary {
      background: linear-gradient(180deg, #d32f2f, #b71c1c);
      color: #fff;
      box-shadow: 0 10px 16px rgba(183, 28, 28, 0.18);
    }
    .btn-secondary {
      background: #fff;
      color: var(--accent-color);
      border: 1px solid rgba(198,40,40,0.25);
      box-shadow: 0 10px 16px rgba(0,0,0,0.05);
    }

    /* Mensaje emergente */
    .toast {
      position: absolute;
      left: 50%;
      top: 16px;
      transform: translateX(-50%);
      background: rgba(255,255,255,0.92);
      border: 1px solid rgba(198,40,40,0.18);
      color: #6d1b1b;
      padding: 10px 12px;
      border-radius: 14px;
      box-shadow: 0 14px 22px rgba(0,0,0,0.07);
      font-weight: 700;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease, transform 0.25s ease;
      z-index: 30;
      max-width: 92%;
      text-align: center;
    }
    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(4px);
    }

    /* Contador */
    .counter-section {
      width: 100%;
      margin-top: auto;
      border-top: 1px solid rgba(0,0,0,0.06);
      padding-top: 16px;
      text-align: center;
    }

    .counter-label {
      font-size: 0.9rem;
      color: #888;
      margin-bottom: 10px;
      display: block;
    }

    .timer {
      display: flex;
      justify-content: space-around;
      font-family: 'Nunito', sans-serif;
      color: var(--accent-color);
      gap: 6px;
    }

    .time-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      background: rgba(198, 40, 40, 0.04);
      border: 1px solid rgba(198, 40, 40, 0.10);
      padding: 10px 10px;
      border-radius: 14px;
      min-width: 84px;
    }

    .time-value {
      font-size: 1.4rem;
      font-weight: 800;
      line-height: 1.1;
    }

    .time-label {
      font-size: 0.68rem;
      text-transform: uppercase;
      color: #999;
      letter-spacing: 0.08em;
      margin-top: 4px;
    }

    /* QR */
    .qr-wrap {
      width: 100%;
      margin: 12px 0 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: 12px;
      border-radius: 16px;
      background: rgba(255, 205, 210, 0.28);
      border: 1px solid rgba(198,40,40,0.12);
    }
    .qr-title {
      font-weight: 800;
      color: #7a2a2a;
      font-size: 0.95rem;
      text-align: center;
    }
    .qr-sub {
      font-size: 0.85rem;
      color: #7a2a2a;
      opacity: 0.85;
      text-align: center;
      margin-top: -2px;
    }
    #qrcode {
      background: white;
      padding: 10px;
      border-radius: 14px;
      box-shadow: 0 10px 16px rgba(0,0,0,0.06);
    }
    .copy-row {
      width: 100%;
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .small {
      font-size: 0.82rem;
      opacity: 0.9;
      font-weight: 700;
    }

    /* Corazones flotantes */
    .floating-heart {
      position: fixed;
      left: 0;
      top: 110%;
      width: 16px;
      height: 16px;
      background: rgba(229, 115, 115, 0.55);
      transform: rotate(45deg);
      border-radius: 2px;
      z-index: 0;
      pointer-events: none;
      animation: floatUp linear forwards;
      filter: drop-shadow(0 8px 10px rgba(0,0,0,0.05));
    }
    .floating-heart::before,
    .floating-heart::after {
      content: "";
      position: absolute;
      width: 16px;
      height: 16px;
      background: inherit;
      border-radius: 50%;
    }
    .floating-heart::before { top: -8px; left: 0; }
    .floating-heart::after { left: -8px; top: 0; }

    @keyframes floatUp {
      from { transform: translateY(0) rotate(45deg) scale(1); opacity: 0.0; }
      10% { opacity: 1; }
      to { transform: translateY(-140vh) rotate(45deg) scale(1.4); opacity: 0; }
    }

    /* Lluvia de corazones (click) */
    .burst-heart {
      position: fixed;
      width: 14px;
      height: 14px;
      background: rgba(211,47,47,0.85);
      transform: rotate(45deg);
      border-radius: 2px;
      z-index: 50;
      pointer-events: none;
      animation: burst 900ms ease-out forwards;
    }
    .burst-heart::before, .burst-heart::after {
      content: "";
      position: absolute;
      width: 14px;
      height: 14px;
      background: inherit;
      border-radius: 50%;
    }
    .burst-heart::before { top: -7px; left: 0; }
    .burst-heart::after { left: -7px; top: 0; }

    @keyframes burst {
      from { transform: translate(0,0) rotate(45deg) scale(0.6); opacity: 1; }
      to { transform: translate(var(--dx), var(--dy)) rotate(45deg) scale(1.35); opacity: 0; }
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="toast" id="toast"></div>

    <div class="header-text">
      <h1>Para el amor de mi vida, Solanch:</h1>
      <p>Si pudiera elegir un lugar seguro, sería a tu lado.</p>
      <p>Cuanto más tiempo estoy contigo, más te amo. Eres mi código favorito y mi excepción no controlada.</p>
    </div>

    <div class="tree-container">
      <div class="leaves-container" id="heartTree"></div>
      <div class="trunk"></div>
    </div>

    <div class="actions">
      <button class="btn btn-primary" id="loveBtn">💖 Te amo</button>
      <button class="btn btn-secondary" id="musicBtn">🎵 Activar música</button>
      <button class="btn btn-secondary" id="shareBtn">🔗 Copiar link</button>
    </div>

    <div class="qr-wrap">
      <div class="qr-title">📱 Escanéame, Solanch</div>
      <div class="qr-sub">Para abrir esta página desde tu celu</div>
      <div id="qrcode"></div>
      <div class="copy-row">
        <button class="btn btn-secondary small" id="copyUrlBtn">📋 Copiar URL</button>
        <button class="btn btn-secondary small" id="copyMsgBtn">💌 Copiar mensaje</button>
      </div>
      <div class="qr-sub" id="qrHint">Tip: cuando lo subas a GitHub Pages, el QR se actualizará solo.</div>
    </div>

    <div class="counter-section">
      <span class="counter-label">Mi amor por ti comenzó hace...</span>
      <div class="timer">
        <div class="time-box">
          <span class="time-value" id="days">0</span>
          <span class="time-label">Días</span>
        </div>
        <div class="time-box">
          <span class="time-value" id="hours">0</span>
          <span class="time-label">Horas</span>
        </div>
        <div class="time-box">
          <span class="time-value" id="minutes">0</span>
          <span class="time-label">Min</span>
        </div>
        <div class="time-box">
          <span class="time-value" id="seconds">0</span>
          <span class="time-label">Seg</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    // =========================
    // 1) CONTADOR DESDE FECHA
    // =========================
    const startDate = new Date('2024-06-19T00:00:00');

    function updateTimer() {
      const now = new Date();
      const diff = now - startDate;

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      document.getElementById('days').innerText = days;
      document.getElementById('hours').innerText = hours;
      document.getElementById('minutes').innerText = minutes;
      document.getElementById('seconds').innerText = seconds;
    }
    setInterval(updateTimer, 1000);
    updateTimer();

    // =========================
    // 2) ÁRBOL DE CORAZONES
    // =========================
    function createHeartTree() {
      const container = document.getElementById('heartTree');
      const colors = ['#d32f2f', '#e57373', '#ef5350', '#ffcdd2', '#c62828'];

      // copa tipo nube: distribución polar con bias al centro
      for (let i = 0; i < 72; i++) {
        const heart = document.createElement('div');
        heart.classList.add('heart');

        const angle = Math.random() * Math.PI * 2;
        const radius = Math.pow(Math.random(), 0.6) * 110; // bias al centro
        const x = 125 + radius * Math.cos(angle) - 7;
        const y = 125 + radius * Math.sin(angle) - 7;

        heart.style.left = `${x}px`;
        heart.style.top  = `${y}px`;
        heart.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];

        const scale = 0.55 + Math.random() * 0.95;
        heart.style.transform = `scale(${scale}) rotate(45deg)`;
        heart.style.animationDelay = `${Math.random() * 2.2}s`;

        container.appendChild(heart);
      }
    }
    createHeartTree();

    // =========================
    // 3) CORAZONES FLOTANTES
    // =========================
    function spawnFloatingHeart() {
      const h = document.createElement('div');
      h.className = 'floating-heart';

      const size = 10 + Math.random() * 18;
      h.style.width = `${size}px`;
      h.style.height = `${size}px`;

      const left = Math.random() * 100;
      h.style.left = `${left}vw`;

      const duration = 4 + Math.random() * 5.5;
      h.style.animationDuration = `${duration}s`;

      const alpha = 0.25 + Math.random() * 0.55;
      h.style.background = `rgba(229,115,115,${alpha})`;

      document.body.appendChild(h);
      setTimeout(() => h.remove(), duration * 1000 + 200);
    }

    // genera corazones continuamente
    setInterval(spawnFloatingHeart, 420);

    // =========================
    // 4) BOTÓN "TE AMO" + LLUVIA
    // =========================
    const toast = document.getElementById('toast');
    function showToast(msg) {
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 1600);
    }

    function burstHearts(x, y) {
      const n = 18;
      for (let i = 0; i < n; i++) {
        const b = document.createElement('div');
        b.className = 'burst-heart';
        b.style.left = `${x}px`;
        b.style.top  = `${y}px`;

        const dx = (Math.random() - 0.5) * 220;
        const dy = (Math.random() - 0.8) * 220;
        b.style.setProperty('--dx', `${dx}px`);
        b.style.setProperty('--dy', `${dy}px`);

        const hue = 350 + Math.random() * 15;
        b.style.background = `hsla(${hue}, 75%, 55%, 0.88)`;

        document.body.appendChild(b);
        setTimeout(() => b.remove(), 950);
      }
    }

    document.getElementById('loveBtn').addEventListener('click', (e) => {
      showToast('Solanch, te amo más de lo que las palabras alcanzan 💖');
      burstHearts(e.clientX, e.clientY);
    });

    // =========================
    // 5) MÚSICA ROMÁNTICA (WebAudio)
    //    Nota: requiere interacción (botón) por políticas del navegador
    // =========================
    let audioCtx = null;
    let musicOn = false;
    let musicTimer = null;

    function midiToFreq(m) {
      return 440 * Math.pow(2, (m - 69) / 12);
    }

    function playNote(ctx, freq, t, dur, gainVal=0.08) {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(freq, t);

      // envolvente suave
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(gainVal, t + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);

      o.connect(g);
      g.connect(ctx.destination);

      o.start(t);
      o.stop(t + dur + 0.02);
    }

    function startMusic() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const ctx = audioCtx;

      // progresión romántica: C - Am - F - G (arpegios)
      const chords = [
        [60, 64, 67], // C
        [57, 60, 64], // Am
        [53, 57, 60], // F
        [55, 59, 62], // G
      ];

      let idx = 0;
      const tempo = 78; // bpm
      const beat = 60 / tempo;
      const pattern = [0, 1, 2, 1]; // arpegio

      const schedule = () => {
        const now = ctx.currentTime;
        const chord = chords[idx % chords.length];

        // 1 compás = 4 beats
        for (let step = 0; step < 4; step++) {
          const note = chord[pattern[step]];
          const t = now + step * beat;
          playNote(ctx, midiToFreq(note), t, beat * 0.95, 0.06);
          // nota grave suave
          if (step === 0) playNote(ctx, midiToFreq(note - 12), t, beat * 1.8, 0.03);
        }

        idx++;
      };

      schedule();
      musicTimer = setInterval(schedule, 4 * beat * 1000);
      musicOn = true;
      showToast('Música activada 🎵');
      document.getElementById('musicBtn').textContent = '🔇 Pausar música';
    }

    function stopMusic() {
      if (musicTimer) clearInterval(musicTimer);
      musicTimer = null;
      musicOn = false;
      showToast('Música en pausa 🔇');
      document.getElementById('musicBtn').textContent = '🎵 Activar música';
    }

    document.getElementById('musicBtn').addEventListener('click', async () => {
      try {
        if (!musicOn) {
          if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          if (audioCtx.state === 'suspended') await audioCtx.resume();
          startMusic();
        } else {
          stopMusic();
        }
      } catch (err) {
        showToast('Tu navegador bloqueó el audio. Toca de nuevo ✨');
      }
    });

    // =========================
    // 6) QR ROMÁNTICO + COMPARTIR
    // =========================
    function getShareUrl() {
      // Si ya está publicado (GitHub Pages, etc.) usa la URL real
      // Si está local, el QR mostrará file://... (no sirve en otro celu).
      // Igual lo dejamos para que se auto-actualice cuando lo publiques.
      return window.location.href;
    }

    function buildQRCode() {
      const el = document.getElementById('qrcode');
      el.innerHTML = '';

      const url = getShareUrl();
      if (typeof QRCode === 'undefined') {
        document.getElementById('qrHint').textContent =
          'QR no cargó (sin internet). Cuando tengas internet, aparecerá automáticamente.';
        return;
      }

      new QRCode(el, {
        text: url,
        width: 164,
        height: 164,
        correctLevel: QRCode.CorrectLevel.M
      });
    }

    window.addEventListener('load', () => {
      // esperar un poco para asegurar carga de QRCode.js
      setTimeout(buildQRCode, 250);
    });

    async function copyToClipboard(text) {
      try {
        await navigator.clipboard.writeText(text);
        showToast('Copiado ✅');
      } catch {
        // fallback
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
        showToast('Copiado ✅');
      }
    }

    const romanticMsg =
`Solanch 💖
Te hice una mini página para recordarte lo mucho que te amo.
Ábrela aquí: ${getShareUrl()}`;

    document.getElementById('copyUrlBtn').addEventListener('click', () => copyToClipboard(getShareUrl()));
    document.getElementById('copyMsgBtn').addEventListener('click', () => copyToClipboard(romanticMsg));

    document.getElementById('shareBtn').addEventListener('click', () => {
      // Copia URL (si el navegador permite compartir, lo intenta también)
      const url = getShareUrl();
      if (navigator.share) {
        navigator.share({
          title: 'Para Solanch',
          text: 'Te hice una página con todo mi amor 💖',
          url
        }).catch(() => copyToClipboard(url));
      } else {
        copyToClipboard(url);
      }
    });
  </script>
</body>
</html>
